  "cards": [
    {
      "dot": "rose",
      "title": "The write boundary",
      "items": [
        "A scout has two tools: search and record. It cannot email anyone",
        "record_vendor refuses a directory source, a missing or dead source page, a missing town, an out-of-radius town, and an email that is not the vendor's",
        "Every guard fails open \u2014 only positive evidence of a problem refuses"
      ]
    },
    {
      "dot": "cyan",
      "title": "What bounds a run",
      "items": [
        "25 searches per specialist, 40 for the planner; cap_reached is a normal outcome",
        "Findings are written per vendor, so a truncated scout loses nothing",
        "Every step is priced from a generated catalog and traced to KV and LangSmith"
      ]
    }
