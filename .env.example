# Venus — environment
#
#   cp .env.example .env.local
#
# Only the first block is needed to start the agent. Everything below it has a
# working default, and every optional integration degrades to a reported status
# rather than an exception — a missing key should show up in the trace as
# `not_configured`, never as a crash mid-plan.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Nebius Token Factory. https://studio.nebius.ai — the whole model plane.
NEBIUS_API_KEY=

# Tavily. Every web search the planner and the scouts make.
# Without it `web_search` returns `not_configured` and no vendor is ever found.
TAVILY_API_KEY=

# Upstash Redis (or Vercel KV — either pair works, UPSTASH_* is read first).
# The durable trace store AND the research store. Without it a specialist's
# findings have nowhere to land, so `record_vendor` returns `not_configured`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Outreach — this agent emails real strangers
# ---------------------------------------------------------------------------

# dry_run (default)  no network; the tool reports what it would have sent
# test-inbox         every message is redirected to OUTREACH_TEST_INBOX
# live               a real email to the real vendor
#
# Leave this on dry_run until you mean it. `live` with no RESEND_API_KEY
# reports `not_configured` rather than pretending to send.
OUTREACH_MODE=dry_run

# Where test-inbox mode delivers instead of the vendor.
OUTREACH_TEST_INBOX=

# Resend. Required for test-inbox and live.
RESEND_API_KEY=
# Verifies inbound reply webhooks before they are classified. Untrusted input.
RESEND_WEBHOOK_SECRET=

# Defaults to "Venus <onboarding@resend.dev>", which only delivers to the
# address that owns the Resend account. Use a verified domain to reach anyone.
# OUTREACH_FROM=
# Reply-To on vendor mail, so replies land somewhere the agent can read them.
# OUTREACH_REPLY_ADDRESS=
# Where the couple is told a vendor has answered.
# COUPLE_NOTIFY_EMAIL=
# A ceiling on sends per day across every session. Default 200.
# OUTREACH_DAILY_CAP=200

# ---------------------------------------------------------------------------
# Model routing — one model per job, each swap a line an eval can veto
# ---------------------------------------------------------------------------
# Every id is checked against the generated Token Factory catalog at startup,
# so a typo fails loudly instead of quietly benchmarking a different model.

# NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507            # planner
# NEBIUS_SCOUT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507      # specialists
# NEBIUS_CLASSIFIER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507 # vendor replies
# NEBIUS_JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Pro             # grades the rest

# The judge has its own variable on purpose: the point of a sweep is to change
# the agent's model, and a judge that follows it moves the measuring
# instrument in the same command that moves the thing being measured.

# Route to a model the catalog snapshot cannot price. Cost will report $0.
# NEBIUS_ALLOW_UNKNOWN_MODEL=1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# LangSmith. Optional — the app's own KV trace store and /observe console work
# without it.
LANGSMITH_API_KEY=
# The OTel exporter's export() is a no-op unless this is set. A key alone
# gives you an app that looks instrumented and sends nothing.
LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=venus
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WEB_URL=https://smith.langchain.com

# ---------------------------------------------------------------------------
# Evals and probes — only read by scripts/
# ---------------------------------------------------------------------------

# Rounds in the classifier sweep. Three, because one pass over fifteen cases
# can rule out the clearly worse and cannot separate two candidates near the
# top: a model won a single-pass sweep at 15/15 and scored 11/15 on the next.
# COMPARE_ROUNDS=3
# Rounds in the structured-output probe (15 cases each).
# PROBE_ROUNDS=2
# How long a research turn may run before eval:scout gives up. Default 15 min.
# EVAL_TURN_TIMEOUT_MS=900000
# Venus parks as soon as she has dispatched her scouts, so the grader waits for
# the specialists to settle rather than scoring `0 recorded` against agents
# that are still searching. Default 12 min.
# EVAL_SETTLE_TIMEOUT_MS=720000
# When a specialist with no activity is called stalled. Default 5 min.
# SCOUT_STALL_MS=300000
