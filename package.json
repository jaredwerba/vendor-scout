{
  "name": "wedding",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "eval": "eve eval --tag fast",
    "eval:report": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/eval-report.ts",
    "eval:replies": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/eval-replies.ts",
    "pricing:refresh": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/refresh-pricing.ts",
    "eval:scout": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/eval-scout.ts",
    "eval:all": "npm run test:guards && npm run eval:replies && npm run simulate && npm run eval:scout && npm run eval",
    "eval:slow": "eve eval --tag slow",
    "test:guards": "node --import ./scripts/ts-resolve.mjs scripts/test-vendor-guards.mjs",
    "verify": "npm run typecheck && npm run build && npm run build:eve && npm run test:guards && npm run test:outcomes",
    "models:compare": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/compare-models.ts",
    "probe:schema": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/probe-structured-output.ts",
    "report": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/report.ts",
    "simulate": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/simulate.ts",
    "grade": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/grade.ts",
    "run:eve": "node --env-file=.env.local --import ./scripts/ts-resolve.mjs scripts/run-eve.ts",
    "docs:log": "node --import ./scripts/ts-resolve.mjs scripts/decisions-doc.ts",
    "test:outcomes": "node --import ./scripts/ts-resolve.mjs scripts/test-outcomes.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.2.2",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.24.4",
    "langsmith": "^0.9.0",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.2.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "ai": "^7.0.26"
  },
  "engines": {
    "node": "24.x"
  }
}
